{
  "name": "sentry-react-native-tvos-sample",
  "version": "8.25.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "lint": "npx oxlint",
    "fix": "npx oxlint --fix",
    "type-check": "tsc --noEmit",
    "pod-install-legacy": "cd ios; bundle exec pod install; cd ..",
    "pod-install-legacy-production": "cd ios; PRODUCTION=1 bundle exec pod install; cd ..",
    "clean-tvos": "cd ios; rm -rf Podfile.lock Pods build; cd ..",
    "clean-watchman": "watchman watch-del-all"
  },
  "dependencies": {
    "@sentry/react-native": "8.25.0",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.87.1-0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.0.0",
    "jest": "^29.6.3",
    "sentry-react-native-samples-utils": "workspace:^",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
